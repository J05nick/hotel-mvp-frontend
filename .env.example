# =============================================================================
# Hotel MVP frontend — runtime configuration (12-Factor App, factor III)
# Copy to `.env.local` for local development. These are SERVER-side variables read
# at request time, so one build can run in any environment. Never commit secrets.
# =============================================================================

# Base URL the Next.js SERVER uses to call the backend REST API
# (inside Docker use the service name, e.g. http://api:8000).
API_BASE_URL=http://localhost:8000

# WebSocket endpoint the BROWSER connects to (must be reachable from the user's machine,
# and the page's origin must be listed in the backend's CORS_ORIGINS).
WS_URL=ws://localhost:8000/ws/events

# IANA time zone of the hotel: decides where a "day" starts and how times are displayed.
HOTEL_TIMEZONE=UTC
